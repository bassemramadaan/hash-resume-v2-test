import { create } from 'zustand';
import { ResumeDataSlice, createResumeDataSlice, createEmptyResume } from './slices/resumeDataSlice';
import { SettingsSlice, createSettingsSlice, defaultSettings } from './slices/settingsSlice';
import { UIState, createUISlice } from './slices/useUIStore';
import { ActivationSlice, createActivationSlice, defaultActivation } from './slices/activationSlice';
import { loadSavedResume, loadSavedSettings, loadSavedActivation, initAutosaveLifecycleListeners } from '../utils/resumeStorage';

// Initialize autosave listeners
if (typeof window !== 'undefined') {
  initAutosaveLifecycleListeners();
}

const loadedResume = loadSavedResume(createEmptyResume());
const initialResume = loadedResume.data;
const initialSettings = loadSavedSettings(defaultSettings);
const initialActivation = loadSavedActivation(initialResume, defaultActivation);

export type ResumeStoreState = ResumeDataSlice & SettingsSlice & UIState & ActivationSlice;

export const useResumeStore = create<ResumeStoreState>((set, get) => {
  const dataSlice = createResumeDataSlice(set, get);
  const settingsSlice = createSettingsSlice(set);
  const uiSlice = createUISlice(set, get);
  const activationSlice = createActivationSlice(set, get);

  // Override initial states with loaded storage values
  dataSlice.resumeData = initialResume;
  settingsSlice.settings = initialSettings;
  activationSlice.activation = initialActivation;

  return {
    ...dataSlice,
    ...settingsSlice,
    ...uiSlice,
    ...activationSlice,
  };
});

export { createEmptyResume, defaultSettings, defaultActivation, initialResume, initialSettings, initialActivation };
