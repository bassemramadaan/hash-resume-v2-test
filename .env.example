# AI Kill Switch & Feature Flags (Server-Side Only)
AI_ENABLED=false
AI_SUMMARY_ENABLED=true
AI_ATS_ENABLED=true
AI_ASSISTANT_ENABLED=true
AI_EXPERIENCE_ENABLED=true
AI_SKILLS_ENABLED=true
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Shared Store for Rate Limiting & Cache (Vercel KV / Upstash Redis)
